# Copy to a root-only runtime file. Values are deployment configuration.
# Bind to the worker's Tailscale address; never use 0.0.0.0.
OPENNICF_EMBEDDING_HOST=embedding.internal.example
OPENNICF_EMBEDDING_PORT=8080
OPENNICF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
OPENNICF_EMBEDDING_DIMENSION=768
OPENNICF_EMBEDDING_MAX_INPUT_TOKENS=512
OPENNICF_EMBEDDING_BATCH_SIZE=2
# Generate/store this outside Git; consumers use the same protected value.
OPENNICF_EMBEDDING_SERVICE_TOKEN=
