#!/usr/bin/env python3
"""Synthetic readiness endpoint for the controlled runner."""

from __future__ import annotations

import json
import os
import sys
from urllib.request import Request, urlopen
from pathlib import Path
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from opennicf.ops.health import HealthState, check_health


def _flag(name: str, default: str = "ok") -> bool:
    return os.environ.get(name, default).lower() == "ok"


def _embedding_report() -> dict:
    base_url = os.environ.get("OPENNICF_EMBEDDING_BASE_URL", "").rstrip("/")
    if not base_url:
        return {"reachable": _flag("EMBEDDING_HEALTH"), "provider_healthy": _flag("EMBEDDING_PROVIDER_HEALTH")}
    headers = {"Accept": "application/json"}
    token = os.environ.get("OPENNICF_EMBEDDING_SERVICE_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    try:
        request = Request(base_url + "/health", headers=headers)
        with urlopen(request, timeout=5) as response:
            payload = json.loads(response.read().decode())
        return {"reachable": payload.get("status") == "ok",
                "provider_healthy": payload.get("status") == "ok" and not payload.get("fallback", False),
                "cpu_fallback": bool(payload.get("fallback", False))}
    except Exception:  # dependency probes are represented in the aggregate report
        return {"reachable": False, "provider_healthy": False, "cpu_fallback": False}


def main() -> int:
    correlation_id = os.environ.get("CORRELATION_ID") or f"health-{uuid4()}"
    embedding = _embedding_report()
    report = check_health(
        "opennicf",
        [
            ("postgres", lambda: _flag("POSTGRES_HEALTH")),
            ("lmstudio", lambda: _flag("LM_STUDIO_HEALTH")),
            ("litellm", lambda: _flag("LITELLM_HEALTH")),
            ("broker", lambda: _flag("BROKER_HEALTH")),
            ("embedding-service", lambda: embedding["reachable"]),
            ("embedding-provider", lambda: embedding["provider_healthy"]),
        ],
        release_id=os.environ.get("RELEASE_ID"),
    )
    payload = report.as_dict()
    payload["correlation_id"] = correlation_id
    print(json.dumps(payload, sort_keys=True))
    return 0 if report.state is HealthState.OK else 1


if __name__ == "__main__":
    raise SystemExit(main())
