#!/usr/bin/env python3
"""Synthetic readiness endpoint for the controlled runner."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from urllib.request import Request, urlopen
from uuid import uuid4

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from opennicf.ops.health import HealthState, check_health


def _flag(name: str, default: str = "ok") -> bool:
    return os.environ.get(name, default).lower() == "ok"


def _embedding_report() -> dict:
    if os.environ.get("OPENNICF_EMBEDDING_REMOTE_ENABLED", "false").lower() != "true":
        return {
            "reachable": False,
            "provider_healthy": False,
            "remote_enabled": False,
            "detail": "embedding_endpoint_disabled",
        }
    base_url = os.environ.get("OPENNICF_EMBEDDING_BASE_URL", "").rstrip("/")
    if not base_url:
        return {
            "reachable": _flag("EMBEDDING_HEALTH"),
            "provider_healthy": _flag("EMBEDDING_PROVIDER_HEALTH"),
            "remote_enabled": True,
        }
    headers = {"Accept": "application/json"}
    token = os.environ.get("OPENNICF_EMBEDDING_SERVICE_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    try:
        request = Request(base_url + "/v1/models", headers=headers)
        with urlopen(request, timeout=5) as response:
            payload = json.loads(response.read().decode())
        advertised = {
            item.get("id") for item in payload.get("data", [])
            if isinstance(item, dict)
        }
        text_model = os.environ.get(
            "OPENNICF_TEXT_EMBEDDING_MODEL",
            "text-embedding-qwen3-embedding-4b",
        )
        return {
            "reachable": True,
            "provider_healthy": text_model in advertised,
            "text_model_advertised": text_model in advertised,
            "remote_enabled": True,
        }
    except Exception:  # noqa: BLE001 - dependency probes become aggregate health state
        return {"reachable": False, "provider_healthy": False, "remote_enabled": True}


def main() -> int:
    correlation_id = os.environ.get("CORRELATION_ID") or f"health-{uuid4()}"
    embedding = _embedding_report()
    report = check_health(
        "opennicf",
        [
            ("postgres", lambda: _flag("POSTGRES_HEALTH")),
            ("lmstudio", lambda: _flag("LM_STUDIO_HEALTH")),
            ("litellm", lambda: _flag("LITELLM_HEALTH")),
            ("broker", lambda: _flag("BROKER_HEALTH")),
            ("embedding-service", lambda: embedding["reachable"]),
            ("embedding-provider", lambda: embedding["provider_healthy"]),
        ],
        release_id=os.environ.get("RELEASE_ID"),
    )
    payload = report.as_dict()
    payload["correlation_id"] = correlation_id
    print(json.dumps(payload, sort_keys=True))
    return 0 if report.state is HealthState.OK else 1


if __name__ == "__main__":
    raise SystemExit(main())
