# Runtime-only OpenNICF/QwenAgent model-router configuration.
# Inject LITELLM_API_KEY through the deployment secret mechanism; never commit it.

# LM Studio remains the local-first provider.
LMSTUDIO_BASE_URL=http://<lm-studio-lan-host>:1234
LMSTUDIO_MODEL=<configured-local-model>

# Use the configured remote OpenAI-compatible provider. Keep the actual
# endpoint in the deployment secret/runtime configuration, not in Git.
LITELLM_BASE_URL=<configured-remote-provider-base-url>
LITELLM_MODEL=openclaw-cheap
LITELLM_API_KEY=

LITELLM_TIMEOUT_SECONDS=45
LITELLM_MAX_RETRIES=1

# Issue #5 knowledge platform: inject the DSN through the protected runner
# secret mechanism; never commit a real value. The object store is local to
# the application runtime and contains immutable content-hash objects.
OPENNICF_POSTGRES_DSN=<runtime-secret-dsn>
OPENNICF_OBJECT_STORE_ROOT=/var/lib/opennicf/objects

# Local Qwen worker. Keep the real MagicDNS name and token in protected
# deployment configuration; Tailscale is transport, not provider logic.
OPENNICF_EMBEDDING_BASE_URL=http://192.168.1.137:1234
OPENNICF_EMBEDDING_SERVICE_TOKEN=
OPENNICF_EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
OPENNICF_EMBEDDING_DIMENSION=768
OPENNICF_EMBEDDING_NATIVE_DIMENSION=2560
