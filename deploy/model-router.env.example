# Runtime-only OpenNICF/QwenAgent model-router configuration.
# Inject LITELLM_API_KEY through the deployment secret mechanism; never commit it.

# LM Studio remains the local-first provider.
LMSTUDIO_BASE_URL=http://<lm-studio-lan-host>:1234
LMSTUDIO_MODEL=<configured-local-model>

# Use the current NullClaw clawproxy fallback over Tailscale. The router
# appends /v1 to this base URL.
LITELLM_BASE_URL=http://100.72.156.38:8080
LITELLM_MODEL=openclaw-cheap
LITELLM_API_KEY=

LITELLM_TIMEOUT_SECONDS=45
LITELLM_MAX_RETRIES=1
