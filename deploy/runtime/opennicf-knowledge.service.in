[Unit]
Description=OpenNICF knowledge service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opennicf
Group=opennicf
EnvironmentFile=/etc/opennicf/knowledge.env
WorkingDirectory=/opt/opennicf/current
Environment=PYTHONPATH=/opt/opennicf/current/src
ExecStart=/usr/bin/python3 -m opennicf.service_runtime --service knowledge
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opennicf /var/log/opennicf

[Install]
WantedBy=multi-user.target
